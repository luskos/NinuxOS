# bags.py - Bags (NinuxOS v3.0.11): a folder on the desktop, as on a phone.
#
# The icon is the folder itself: it shows the first nine things that are inside. A click
# opens it as a small panel without a frame; a click on a thing starts it and the panel is gone.
#   an empty place (+)   choose what goes in
#   right button         take the thing out of the bag (the object itself stays in the cabinet)
#   Left / Right, dots   the three pages (27 places)
#   1 .. 9               start the thing in that place
#   L                    make the bag a vault (it then asks for a password) / take the lock off
#   ESC, a click beside  close
#
# What is inside is kept in the object NAME_bag (NAME is the name of this object): a text, a
# line a place; the first line is the lock. A clone of this object with another name and label
# is another folder with its own contents.
#
# No "icon" in META: the desktop then asks the socket draw for the icon every time, and that is
# how the icon can show what is inside. draw takes no memory (own_len, own_code, text_meta).
#
# Not there yet: the small pictures of the programs (a function that loads an image is needed),
# and a tie to a drawer of the cabinet (a program cannot move objects between drawers yet).
# The lock keeps the panel shut; it does not encrypt anything.

META = {"type": "icon", "label": "Bags", "kind": "app"}

FRAME = 0       # 1: an ordinary window with a frame (if the desktop does not like a bare panel)
PW = 372
PH = 446
NS = 27
PX = 0
PY = 0
SLOT = []
PICK = []
PAL = [0xFFB020, 0x2FB7FF, 0xA3E635, 0xFF3D8B, 0x7B5CFF, 0x00D6B4, 0xFF8A65, 0xE0E0F0]
lock = ""
page = 0
mode = 0        # 0 the things, 1 choosing what goes in
want = 0
ptop = 0
status = "Click: start. +: put in. Right: out."


def draw(x, y):
    fill_round(x + 24, y + 4, 48, 48, 0x2A2840, 12)
    n = own_len("_bag")
    if n > 0 and own_code("_bag", 0) != 10:
        # a vault does not show what it holds: a keyhole
        fill_round(x + 40, y + 16, 16, 16, 0xFFB020, 8)
        fill(x + 45, y + 28, 6, 14, 0xFFB020)
    else:
        i = 0
        line = 0
        h = 0
        letters = 0
        shown = 0
        while i <= n and shown < 9:
            c = 10
            if i < n:
                c = own_code("_bag", i)
            if c == 10:
                if line > 0 and letters > 0:
                    fill_round(x + 28 + (shown % 3) * 14, y + 8 + (shown // 3) * 14, 12, 12, PAL[h % 8], 3)
                    shown = shown + 1
                line = line + 1
                h = 0
                letters = 0
            else:
                h = (h * 31 + c) % 16777216
                letters = letters + 1
            i = i + 1
    text_meta(x + 48, y + 58, "label", 0xFFFFFF)


def _colour(name):
    # the same colour the icon gives this name
    h = 0
    i = 0
    while i < len(name):
        h = (h * 31 + code(name, i)) % 16777216
        i = i + 1
    return PAL[h % 8]


def _hash(s):
    h = 5381
    i = 0
    while i < len(s):
        h = (h * 33 + code(s, i)) % 4294967296
        i = i + 1
    return str(h)


def _status(s):
    global status
    status = s
    fill(PX + 14, PY + 422, PW - 28, 18, 0x1E1C30)
    text(PX + 16, PY + 423, status, 0x9AA0B6)


def _save():
    s = lock
    i = 0
    while i < NS:
        s = s + "\n" + SLOT[i]
        i = i + 1
    save_text(meta("name") + "_bag", s)


def _load():
    global lock
    while len(SLOT) > 0:
        SLOT.pop()
    i = 0
    while i < NS:
        SLOT.append("")
        i = i + 1
    lock = ""
    d = load_text(meta("name") + "_bag")
    if len(d) == 0:
        return 0
    lock = field(d, 10, 0)
    i = 0
    while i < NS:
        SLOT[i] = field(d, 10, i + 1)
        i = i + 1
    return 1


def _things():
    fill(PX + 10, PY + 40, PW - 20, 380, 0x1E1C30)
    i = 0
    while i < 9:
        gx = PX + 18 + (i % 3) * 116
        gy = PY + 48 + (i // 3) * 116
        name = SLOT[page * 9 + i]
        if len(name) == 0:
            fill_round(gx, gy, 104, 104, 0x232136, 16)
            text(gx + 48, gy + 44, "+", 0x55526E)
        else:
            lab = meta_of(name, "label")
            if len(lab) == 0:
                lab = name
            if len(lab) > 12:
                lab = lab[:12]
            c = code(lab, 0)
            if c >= 97 and c <= 122:
                c = c - 32
            fill_round(gx, gy, 104, 104, 0x2A2840, 16)
            fill_round(gx + 28, gy + 12, 48, 48, _colour(name), 12)
            text(gx + 48, gy + 28, char(c), 0x12131C)
            text(gx + 52 - len(lab) * 4, gy + 72, lab, 0xECECF5)
        i = i + 1
    i = 0
    while i < 3:
        c = 0x55526E
        if i == page:
            c = 0xF5F4FF
        fill_round(PX + PW // 2 - 25 + i * 20, PY + 402, 10, 10, c, 5)
        i = i + 1


def _collect():
    while len(PICK) > 0:
        PICK.pop()
    n = ob_count()
    i = 0
    while i < n:
        t = ob_meta(i, "type")
        k = ob_meta(i, "kind")
        if t == "icon" or k == "app" or k == "game" or t == "page" or t == "text":
            PICK.append(i)
        i = i + 1


def _chooser():
    fill(PX + 10, PY + 40, PW - 20, 380, 0x1E1C30)
    text(PX + 18, PY + 46, "What goes in? PgUp / PgDn; ESC: nothing", 0x9AA0B6)
    r = 0
    while r < 14 and ptop + r < len(PICK):
        i = PICK[ptop + r]
        y = PY + 72 + r * 24
        text(PX + 24, y, ob_meta(i, "name"), 0xECECF5)
        text(PX + 160, y, ob_meta(i, "label"), 0x00D6B4)
        r = r + 1


def _frame():
    cursor_hide()
    if FRAME == 1:
        window(PX, PY, PW, PH, meta("label"))
    else:
        fill_round(PX, PY, PW, PH, 0x7B5CFF, 22)
        fill_round(PX + 2, PY + 2, PW - 4, PH - 4, 0x1E1C30, 20)
        t = meta("label")
        text(PX + PW // 2 - len(t) * 4, PY + 14, t, 0xFFFFFF)
    if len(lock) > 0:
        text(PX + PW - 64, PY + 14, "vault", 0xFFB020)
    if mode == 1:
        _chooser()
    else:
        _things()
    _status(status)


def _ask(prompt):
    # a line typed by the user, shown as stars; "" when ESC was pressed
    typed = ""
    shown = 1
    while True:
        if shown == 1:
            stars = ""
            i = 0
            while i < len(typed):
                stars = stars + "*"
                i = i + 1
            _status(prompt + " " + stars)
            shown = 0
        if poll() == 1:
            k = key()
            if k == 27:
                return ""
            if k == 13 or k == 10:
                return typed
            if k == 8 and len(typed) > 0:
                typed = typed[:len(typed) - 1]
                shown = 1
            elif k >= 32 and k < 127 and len(typed) < 24:
                typed = typed + char(k)
                shown = 1


def _lock():
    global lock
    if len(lock) > 0:
        lock = ""
        _save()
        _frame()
        _status("The lock is off: an ordinary bag again.")
        return 0
    p = _ask("New password, Enter:")
    if len(p) == 0:
        _status("No password given: nothing changed.")
        return 0
    lock = _hash(p)
    _save()
    _frame()
    _status("A vault now: it asks for the password.")
    return 1


def _start(i):
    # 1: started (the panel closes), 0: not
    if len(SLOT[i]) == 0:
        return 0
    if spawn(SLOT[i]) < 0:
        _status("'" + SLOT[i] + "' is not in the cabinet any more.")
        return 0
    return 1


def _press(mx, my, right):
    # a click; 1: the panel closes
    global page, mode, want, ptop
    if mx < PX or mx >= PX + PW or my < PY or my >= PY + PH:
        return 1
    if mode == 1:
        if my >= PY + 70 and my < PY + 70 + 14 * 24:
            r = ptop + (my - PY - 70) // 24
            if r < len(PICK):
                SLOT[want] = ob_meta(PICK[r], "name")
                _save()
                mode = 0
                _things()
                _status("Put in: " + SLOT[want] + ".")
        return 0
    if my >= PY + 398 and my < PY + 418:
        i = (mx - (PX + PW // 2 - 30)) // 20
        if mx >= PX + PW // 2 - 30 and i < 3:
            page = i
            _things()
        return 0
    if mx < PX + 18 or my < PY + 48:
        return 0
    c = (mx - PX - 18) // 116
    r = (my - PY - 48) // 116
    if c > 2 or r > 2 or (mx - PX - 18) % 116 >= 104 or (my - PY - 48) % 116 >= 104:
        return 0
    i = page * 9 + r * 3 + c
    if right == 1:
        if len(SLOT[i]) > 0:
            SLOT[i] = ""
            _save()
            _things()
            _status("Taken out. The object is still in the cabinet.")
        return 0
    if len(SLOT[i]) == 0:
        want = i
        ptop = 0
        mode = 1
        _collect()
        _chooser()
        _status("Click what goes in.")
        return 0
    return _start(i)


def open(sw, sh):
    global PX, PY, page, mode, ptop
    PX = (sw - PW) // 2
    PY = (sh - PH) // 2
    page = 0
    mode = 0
    _load()
    if len(lock) > 0:
        # a vault: nothing is shown before the password
        cursor_hide()
        fill_round(PX, PY, PW, PH, 0x7B5CFF, 22)
        fill_round(PX + 2, PY + 2, PW - 4, PH - 4, 0x1E1C30, 20)
        text(PX + PW // 2 - 20, PY + 14, "vault", 0xFFB020)
        tries = 0
        while True:
            p = _ask("Password, Enter (ESC: leave):")
            if len(p) == 0:
                return 1
            if _hash(p) == lock:
                break
            tries = tries + 1
            if tries >= 3:
                log("Bags: three wrong passwords")
                return 1
    _frame()
    old_b = 0
    running = 1
    while running == 1:
        e = poll()
        if e == 1:
            k = key()
            if k == 27:
                if mode == 1:
                    mode = 0
                    _things()
                    _status("Nothing put in.")
                else:
                    running = 0
            elif mode == 1:
                if k == 0x88 and ptop + 14 < len(PICK):
                    ptop = ptop + 14
                    _chooser()
                elif k == 0x87:
                    ptop = ptop - 14
                    if ptop < 0:
                        ptop = 0
                    _chooser()
            elif k >= 49 and k <= 57:
                if _start(page * 9 + k - 49) == 1:
                    running = 0
            elif k == 0x83 or k == 0x88:
                if page < 2:
                    page = page + 1
                    _things()
            elif k == 0x82 or k == 0x87:
                if page > 0:
                    page = page - 1
                    _things()
            elif k == 108 or k == 76:
                _lock()
        elif e == 2:
            b = mouse_buttons()
            if b == 1 and old_b == 0:
                if _press(mouse_x(), mouse_y(), 0) == 1:
                    running = 0
            elif b == 2 and old_b == 0:
                if _press(mouse_x(), mouse_y(), 1) == 1:
                    running = 0
            old_b = b
    log("Bags closed")
    return 1
