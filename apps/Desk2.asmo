# desk2.py - the desktop written anew (NinuxOS v3.0.30). Steps 2 - 5 of docs/DESKTOP.md.
#
# In the shell:  desk desk2      (the usual `desktop` still runs the old one)
#
#   a click on an icon         open it: a program in a window, a drawer, a page in NET
#   hold and move an icon      put it somewhere else (kept in the object desk2_places)
#   the mouse resting on one   its card: what the object says about itself
#   the right button on one    a menu: open, data dump, about it - and "The system's menu":
#                              everything the system does to an object (view, edit, clone, rename,
#                              hide, lock, inject, erase, share ...), the same menu the old desktop has
#   the right button elsewhere a menu: settings, files, tidy the icons, the shell, the system's menu
#   the button N               the start menu: settings, files, the shell, restart, shut down
#   a button of the taskbar    that program to the front
#   a click on a bag           what is inside, in a panel over the desk; a click there starts it
#   the top edge of the screen the curtain: settings, files, the shell, power, what the machine is
#   < 1/2 > on the taskbar,    more desktops: an icon let go at the left or right edge of the
#   PgUp / PgDn                screen goes to the desktop on that side (a new one, if there is none)
#   "All at once" in the menus the screen split in 4 or 9: everything that runs, each in its part,
#                              made small; a click on one brings it to the front, ESC the screen back
#   ESC                        back to the shell
#
# What the old desktop does and this one does not yet: the taskbar as a page, hidden objects
# shown on request, "inject" by a click on a second object.
#
# Everything here is plain PyTon over the system's functions - this file is the source.

META = {"type": "desktop", "label": "Desk2", "screen": "full"}

TB = 34         # the height of the taskbar
CW = 96         # an icon's cell
CH = 92
ITEMS = []      # the numbers of the objects that have icons, in the order they are drawn
KIND = []       # for each: 0 a program, 1 a script, 2 a page, 3 a drawer, 4 "back" out of a drawer
PX = []         # where each icon stands
PY = []
PG = []         # ... and the desktop it is on
PN = []         # the places the user gave: the name of an object, its x, its y, its desktop
PXS = []
PYS = []
PGS = []
BAGN = []       # the names of the things in the bag whose panel is open
CURT = ["settings", "files", "shell", "tidy", "restart", "off"]
CURL = ["Settings", "Files", "Shell", "Tidy", "Restart", "Off"]
page = 0        # the desktop that is shown
pages = 1       # how many there are
TASKS = []      # the places of the multiplexer that have buttons on the taskbar
MENU = []       # the lines of the menu that is open
ACTS = []       # what each line does
drawer = -1     # the number of the drawer that is open, -1: the cabinet itself
sw = 0
sh = 0
rows = 1
msg = "Desk2: the new desktop. Right button: a menu."
seen_cabinet = -1
seen_tasks = -1
over = 0        # what lies over the desk: 0 nothing, 1 a menu, 2 a card, 3 a bag, 4 the curtain
over_keep = 0   # what was under it (rect_save)
over_x = 0
over_y = 0
over_w = 0
over_h = 0
menu_for = -1   # the icon the menu is for, -1: the desk itself
menu_x = 0      # where the right button was pressed
menu_y = 0


# ---------------------------------------------------------------- what is on the desk

def _places_load():
    while len(PN) > 0:
        PN.pop()
        PXS.pop()
        PYS.pop()
        PGS.pop()
    d = load_text("desk2_places")
    for line in d.split("\n"):
        f = line.split(",")
        if len(f) == 3 or len(f) == 4:
            PN.append(f[0])
            PXS.append(int(f[1]))
            PYS.append(int(f[2]))
            if len(f) == 4:
                PGS.append(int(f[3]))
            else:
                PGS.append(0)


def _places_save():
    s = ""
    i = 0
    while i < len(PN):
        s = s + PN[i] + "," + str(PXS[i]) + "," + str(PYS[i]) + "," + str(PGS[i]) + "\n"
        i = i + 1
    save_text("desk2_places", s)


def _place_of(name):
    i = 0
    while i < len(PN):
        if PN[i] == name:
            return i
        i = i + 1
    return -1


def _collect():
    global drawer, pages, page
    while len(ITEMS) > 0:
        ITEMS.pop()
        KIND.pop()
    while len(PX) > 0:
        PX.pop()
        PY.pop()
        PG.pop()
    first = 0
    n = cabinet_top()
    if drawer >= 0:
        first = drawer_first(drawer)
        if first < 0:
            drawer = -1
            first = 0
        else:
            n = drawer_count(drawer)
            ITEMS.append(drawer)
            KIND.append(4)
    i = first
    while i < first + n:
        if ob_flags(i) % 2 == 0:
            t = ob_meta(i, "type")
            k = -1
            if t == "icon":
                k = 0
            elif t == "script":
                k = 1
            elif t == "cabinet":
                k = 3
            elif t == "page" and ob_meta(i, "desktop") != "no":
                k = 2
            if k >= 0:
                ITEMS.append(i)
                KIND.append(k)
        i = i + 1
    n = 0
    while n < len(ITEMS):                       # in rows and columns, unless the user put it elsewhere
        x = 16 + (n // rows) * CW
        y = 18 + (n % rows) * CH
        g = page
        if drawer < 0:
            g = 0
            p = _place_of(ob_meta(ITEMS[n], "name"))
            if p >= 0:
                x = PXS[p]
                y = PYS[p]
                g = PGS[p]
        PX.append(x)
        PY.append(y)
        PG.append(g)
        n = n + 1
    pages = 1                                   # as many desktops as are used
    i = 0
    while i < len(PGS):
        if PGS[i] + 1 > pages:
            pages = PGS[i] + 1
        i = i + 1
    if page >= pages:
        page = pages - 1


def _at(mx, my):
    # which icon is there; -1: none
    n = len(ITEMS) - 1
    while n >= 0:
        if PG[n] == page and mx >= PX[n] + 16 and mx < PX[n] + 80 and my >= PY[n] and my < PY[n] + 76:
            return n
        n = n - 1
    return -1


# ---------------------------------------------------------------- drawing

def _label(x, y, s):
    if len(s) > 11:
        s = s[:11]
    text(x + 48 - len(s) * 4, y + 58, s, 0xFFFFFF)


def _tile(x, y, colour, letter):
    fill_round(x + 24, y + 4, 48, 48, 0x1A1828, 12)
    fill_round(x + 28, y + 8, 40, 40, colour, 10)
    text(x + 44, y + 20, letter, 0x12131C)


def _icon(n):
    x = PX[n]
    y = PY[n]
    i = ITEMS[n]
    k = KIND[n]
    if k == 4:
        _tile(x, y, 0x9AA0B6, "<")
        _label(x, y, "back")
        return 0
    name = ob_meta(i, "name")
    lab = ob_meta(i, "label")
    if len(lab) == 0:
        lab = name
    icon = ob_meta(i, "icon")
    if len(icon) > 0 and len(meta_of(icon, "type")) > 0:
        image(x + 24, y + 4, icon)
        _label(x, y, lab)
    elif k == 0 and "draw" in ob_meta(i, "sockets"):
        ob_call(name, "draw", x, y)             # it draws itself, its name too
    else:
        c = code(lab, 0)
        if c >= 97 and c <= 122:
            c = c - 32
        colour = 0x2FB7FF
        if k == 3:
            colour = 0xFFB020
        elif k == 2:
            colour = 0x00D6B4
        elif k == 1:
            colour = 0xA3E635
        _tile(x, y, colour, char(c))
        _label(x, y, lab)
    return 1


def _clock():
    t = system("time")
    fill_round(sw - 176, sh - TB + 5, 168, 24, 0x33305A, 8)
    text(sw - 92 - len(t) * 4, sh - TB + 9, t, 0xFFFFFF)


def _taskbar():
    fill(0, sh - TB, sw, TB, 0x1C1A32)
    fill_round(8, sh - TB + 5, 28, 24, 0x7B5CFF, 8)
    text(18, sh - TB + 9, "N", 0xFFFFFF)
    fill_round(42, sh - TB + 5, 28, 24, 0x2A2840, 8)
    text(48, sh - TB + 9, ">_", 0x00D6B4)
    while len(TASKS) > 0:
        TASKS.pop()
    now = task_focused()
    x = 80
    slot = 1
    while slot < 8:
        name = task_name(slot)
        if len(name) > 0:
            if len(name) > 11:
                name = name[:11]
            c = 0x2A2840
            if slot == now:
                c = 0x7B5CFF
            fill_round(x, sh - TB + 5, 104, 24, c, 8)
            text(x + 52 - len(name) * 4, sh - TB + 9, name, 0xF5F4FF)
            TASKS.append(slot)
            x = x + 112
        slot = slot + 1
    m = msg
    room = (sw - 290 - x) // 8
    if drawer < 0:                              # which desktop, and the way to the next
        t = "< " + str(page + 1) + "/" + str(pages) + " >"
        text(sw - 272, sh - TB + 9, t, 0xC9CEDE)
    if room < 0:
        room = 0
    if len(m) > room:
        m = m[:room]
    text(x + 8, sh - TB + 9, m, 0xFFB020)
    _clock()


def _all():
    global seen_cabinet, seen_tasks, over, over_keep
    cursor_hide()
    over = 0                                    # whatever lay over the desk is drawn over
    over_keep = 0
    image_fit(0, 0, sw, sh, "desktop")          # the wallpaper is the DATA of the old desktop object
    n = 0
    while n < len(ITEMS):
        if PG[n] == page:
            _icon(n)
        n = n + 1
    _taskbar()
    seen_cabinet = cabinet_changes()
    seen_tasks = tasks_changes()


def _say(s):
    global msg
    msg = s
    cursor_hide()
    _taskbar()


# ---------------------------------------------------------------- what lies over the desk: a menu, a card

def _over_close():
    global over, over_keep
    if over == 0:
        return 0
    cursor_hide()
    over = 0
    if over_keep != 0:
        rect_restore(over_keep)
        over_keep = 0
    else:
        _all()                                  # there was no memory to keep what was under it
    return 1


def _over_open(x, y, w, h, what):
    global over, over_keep, over_x, over_y, over_w, over_h
    _over_close()
    if x + w > sw - 4:
        x = sw - 4 - w
    if y + h > sh - TB - 4:
        y = sh - TB - 4 - h
    if x < 4:
        x = 4
    if y < 4:
        y = 4
    cursor_hide()
    over_keep = rect_save(x, y, w, h)
    over = what
    over_x = x
    over_y = y
    over_w = w
    over_h = h
    fill_round(x, y, w, h, 0x7B5CFF, 10)
    fill_round(x + 1, y + 1, w - 2, h - 2, 0x1E1C30, 9)


def _menu(x, y, lines, acts, target):
    global menu_for
    while len(MENU) > 0:
        MENU.pop()
        ACTS.pop()
    w = 0
    i = 0
    while i < len(lines):
        MENU.append(lines[i])
        ACTS.append(acts[i])
        if len(lines[i]) > w:
            w = len(lines[i])
        i = i + 1
    _over_open(x, y, w * 8 + 28, len(MENU) * 24 + 12, 1)
    menu_for = target
    i = 0
    while i < len(MENU):
        text(over_x + 14, over_y + 10 + i * 24, MENU[i], 0xECECF5)
        i = i + 1


def _card(n):
    i = ITEMS[n]
    if KIND[n] == 4:
        return 0
    name = ob_meta(i, "name")
    lab = ob_meta(i, "label")
    if len(lab) == 0:
        lab = name
    kind = ob_meta(i, "type")
    k = ob_meta(i, "kind")
    if len(k) > 0:
        kind = kind + ", " + k
    lang = ob_meta(i, "lang")
    if len(lang) > 0:
        kind = kind + ", written in " + lang
    lines = [lab, "name      " + name, "it is     " + kind]
    d = ob_meta(i, "data")
    if len(d) > 0:
        lines.append("DATA      " + d)
    s = ob_meta(i, "sockets")
    if len(s) > 0:
        lines.append("sockets   " + s)
    lines.append("size      " + str(ob_size(i)) + " bytes, " + str(ob_data(i)) + " of them DATA")
    if ob_state(i) == 3:
        lines.append("locked")
    w = 0
    j = 0
    while j < len(lines):
        if len(lines[j]) > 56:
            lines[j] = lines[j][:56]
        if len(lines[j]) > w:
            w = len(lines[j])
        j = j + 1
    _over_open(PX[n] + 84, PY[n] + 8, w * 8 + 28, len(lines) * 20 + 16, 2)
    j = 0
    while j < len(lines):
        c = 0xC9CEDE
        if j == 0:
            c = 0xFFFFFF
        text(over_x + 14, over_y + 10 + j * 20, lines[j], c)
        j = j + 1
    return 1


def _bag(n):
    # what is inside the bag n, in a panel over the desk; 0: it is empty or a vault (its own program opens)
    name = ob_meta(ITEMS[n], "name")
    d = load_text(name + "_bag")
    if len(d) == 0 or code(d, 0) != 10:
        return 0
    while len(BAGN) > 0:
        BAGN.pop()
    for line in d.split("\n"):
        if len(line) > 0 and len(BAGN) < 9:
            BAGN.append(line)
    if len(BAGN) == 0:
        return 0
    lab = ob_meta(ITEMS[n], "label")
    _over_open(PX[n] + 70, PY[n] - 60, 288, 48 + ((len(BAGN) + 2) // 3) * 96, 3)
    text(over_x + 144 - len(lab) * 4, over_y + 10, lab, 0xFFFFFF)
    j = 0
    while j < len(BAGN):
        x = over_x + 12 + (j % 3) * 88
        y = over_y + 36 + (j // 3) * 96
        fill_round(x, y, 84, 90, 0x2A2840, 12)
        icon = meta_of(BAGN[j], "icon")
        if len(icon) > 0 and len(meta_of(icon, "type")) > 0:
            image(x + 18, y + 6, icon)
        else:
            fill_round(x + 18, y + 6, 48, 48, 0x2FB7FF, 12)
        t = meta_of(BAGN[j], "label")
        if len(t) == 0:
            t = BAGN[j]
        if len(t) > 10:
            t = t[:10]
        text(x + 42 - len(t) * 4, y + 64, t, 0xECECF5)
        j = j + 1
    return 1


def _curtain():
    # the curtain: comes down from the top edge
    _over_open(sw // 2 - 300, 4, 600, 156, 4)
    j = 0
    while j < 6:
        x = over_x + 12 + j * 97
        fill_round(x, over_y + 12, 91, 40, 0x2A2840, 10)
        text(x + 45 - len(CURL[j]) * 4, over_y + 24, CURL[j], 0xF5F4FF)
        j = j + 1
    text(over_x + 16, over_y + 68, system("cpu"), 0xC9CEDE)
    text(over_x + 16, over_y + 88, "memory " + system("memory") + "    screen " + system("screen"), 0xC9CEDE)
    text(over_x + 16, over_y + 108, system("version"), 0x9AA0B6)
    text(over_x + 16, over_y + 130, "Alt + * : the display off and on", 0x9AA0B6)
    fill_round(over_x + 260, over_y + 148, 80, 4, 0x55526E, 2)


def _start(name):
    # start a thing by its name (out of a bag)
    t = meta_of(name, "type")
    if len(t) == 0:
        _say("'" + name + "' is not in the cabinet any more.")
    elif t == "page":
        open_with("net", "show", name)
    elif t == "script":
        open_with("studio", "run", name)
    else:
        kind = meta_of(name, "kind")
        if kind == "app" or kind == "game":
            spawn(name)
        else:
            cursor_hide()
            ob_call(name, "open", sw, sh)
            _collect()
            _all()
    return 0


def _turn(to):
    # show another desktop
    global page
    if to < 0 or to >= pages or to == page or drawer >= 0:
        return 0
    page = to
    _all()
    return 1


# ---------------------------------------------------------------- doing things

def _open(n, itself):
    # itself = 1: a bag's own program is opened (to change what is inside), not its panel
    global drawer
    i = ITEMS[n]
    k = KIND[n]
    name = ob_meta(i, "name")
    if k == 0 and itself == 0 and ob_meta(i, "bag") == "yes" and _bag(n) == 1:
        return 0
    if k == 4:
        drawer = -1
    elif k == 3:
        drawer = i
    elif ob_state(i) == 3:
        _say("Locked: " + name)
        return 0
    elif k == 2:
        if open_with("net", "show", name) < 0:
            _say("NET is not in the cabinet: the page cannot be shown.")
        return 0
    elif k == 1:
        if open_with("studio", "run", name) < 0:
            _say("Studio is not in the cabinet: the script cannot be run.")
        return 0
    else:
        kind = ob_meta(i, "kind")
        if kind == "app" or kind == "game":
            if spawn(name) < 0:
                _say("'" + name + "' could not be started.")
            return 0
        cursor_hide()
        ob_call(name, "open", sw, sh)           # it takes the whole screen until it is closed
    _collect()
    _all()
    return 1


def _do(act):
    # what a line of a menu does; 1: leave the desktop
    global drawer
    n = menu_for
    name = ""
    if n >= 0 and n < len(ITEMS):
        name = ob_meta(ITEMS[n], "name")
    if act == "open":
        _open(n, 1)
    elif act == "view" or act == "edit":
        if open_with("studio", act, name) < 0:
            _say("Studio is not in the cabinet.")
    elif act == "dump":
        out = name
        if len(out) > 10:
            out = out[:10]
        out = out + "_data"
        got = data_dump(name, out)
        if got == 0:
            _say("'" + name + "' has no DATA to take out.")
        else:
            _say("data dump: " + str(got) + " bytes are now the object '" + out + "'.")
    elif act == "about":
        _card(n)
    elif act == "system":
        # the menu of the system itself: NET shows the page "context" and does what is chosen there
        cursor_hide()
        got = ob_call_on("net", "context", name, menu_y * 65536 + menu_x)
        if got == -1:
            _say("NET is not in the cabinet: the system's menu cannot be shown.")
            return 0
        said = ob_text("net", "message")
        _collect()
        _all()
        if len(said) > 0:
            _say(said)
        if got == 2:
            return 1
        if got == 5 and n >= 0 and n < len(ITEMS):
            _open(n, 1)
        elif got == 6 and len(name) > 0:
            open_with("studio", "edit", name)
        elif got == 3:
            _say("Inject by a click on another object is not in Desk2 yet: use the old desktop for it.")
    elif act == "settings":
        if open_with("net", "show", "curtain") < 0:
            _say("The page of the settings (curtain) is not in the cabinet.")
    elif act == "files":
        if spawn("files") < 0:
            _say("Files is not in the cabinet.")
    elif act == "split4" or act == "split9":
        parts = 4
        if act == "split9":
            parts = 9
        cursor_hide()
        if split(parts) != 0:
            _say("The screen could not be split (no memory, or the kernel is an older one).")
    elif act == "tidy":
        while len(PN) > 0:
            PN.pop()
            PXS.pop()
            PYS.pop()
            PGS.pop()
        _places_save()
        _collect()
        _all()
    elif act == "root":
        drawer = -1
        _collect()
        _all()
    elif act == "shell":
        return 1
    elif act == "restart":
        power(1)
    elif act == "off":
        power(0)
    return 0


def _move(n, mx, my):
    # the icon n was let go at mx, my: it stands there from now on
    x = mx - 48
    y = my - 30
    if x < 0:
        x = 0
    if y < 0:
        y = 0
    if x > sw - CW:
        x = sw - CW
    if y > sh - TB - CH:
        y = sh - TB - CH
    g = page                                    # let go at the left or right edge: the desktop on that side
    if mx < 10 and page > 0:
        g = page - 1
        x = sw - CW - 16
    elif mx > sw - 10 and page < 8:
        g = page + 1
        x = 16
    name = ob_meta(ITEMS[n], "name")
    p = _place_of(name)
    if p < 0:
        PN.append(name)
        PXS.append(x)
        PYS.append(y)
        PGS.append(g)
    else:
        PXS[p] = x
        PYS[p] = y
        PGS[p] = g
    _places_save()
    _collect()
    _all()


def _click(mx, my):
    # the left button on something that is not an icon; 1: leave the desktop
    if over == 1:
        hit = -1
        if mx >= over_x and mx < over_x + over_w and my >= over_y + 6:
            hit = (my - over_y - 6) // 24
        _over_close()
        if hit >= 0 and hit < len(ACTS):
            return _do(ACTS[hit])
        return 0
    if over == 3:                               # a bag's panel: a click on a thing starts it
        hit = -1
        col = (mx - over_x - 12) // 88
        row = (my - over_y - 36) // 96
        if mx >= over_x + 12 and my >= over_y + 36 and col < 3 and row < 3:
            hit = row * 3 + col
        _over_close()
        if hit >= 0 and hit < len(BAGN):
            _start(BAGN[hit])
        return 0
    if over == 4:                               # the curtain
        hit = -1
        if my >= over_y + 12 and my < over_y + 52 and mx >= over_x + 12:
            hit = (mx - over_x - 12) // 97
        _over_close()
        if hit >= 0 and hit < 6:
            return _do(CURT[hit])
        return 0
    if _over_close() == 1:
        return 0
    if my < 6:
        _curtain()
        return 0
    if my >= sh - TB:
        if drawer < 0 and mx >= sw - 276 and mx < sw - 180:
            if mx < sw - 228:
                _turn(page - 1)
            else:
                _turn(page + 1)
            return 0
        if mx < 40:
            _menu(8, sh - TB - 190, ["Settings", "Files", "All at once: 4", "All at once: 9", "The shell", "Restart", "Shut down"],
                  ["settings", "files", "split4", "split9", "shell", "restart", "off"], -1)
            return 0
        if mx < 72:
            return 1
        j = (mx - 80) // 112
        if mx >= 80 and j < len(TASKS):
            task_focus(TASKS[j])
        return 0
    return 0


def _right(mx, my):
    global menu_x, menu_y
    if my >= sh - TB:
        return 0
    menu_x = mx
    menu_y = my
    n = _at(mx, my)
    if n >= 0 and KIND[n] != 4:
        _menu(mx, my, ["Open", "Data dump", "About it", "The system's menu ..."],
              ["open", "dump", "about", "system"], n)
    elif drawer >= 0:
        _menu(mx, my, ["Back to the cabinet", "Settings", "Files", "The shell"],
              ["root", "settings", "files", "shell"], -1)
    else:
        _menu(mx, my, ["Settings", "Files", "All at once: 4", "All at once: 9", "Tidy the icons", "The shell", "The system's menu ..."],
              ["settings", "files", "split4", "split9", "tidy", "shell", "system"], -1)
    return 0


def run(a, b):
    global sw, sh, rows, seen_tasks
    sw = screen_w()
    sh = screen_h()
    rows = (sh - TB - 18) // CH
    if rows < 1:
        rows = 1
    _places_load()
    _collect()
    _all()
    log("[desk2] started")
    old_b = 0
    last = ticks()
    held = -1           # the icon the left button went down on
    held_x = 0
    held_y = 0
    rest_x = 0          # where the mouse rests, and since when
    rest_y = 0
    rest_t = ticks()
    rest_done = 1
    mx = 0
    my = 0
    while True:
        e = poll()
        if e == 1:
            k = key()
            if k == 27:
                if _over_close() == 0:
                    break
            elif k == 0x88:
                _turn(page + 1)
            elif k == 0x87:
                _turn(page - 1)
        elif e == 2:
            mx = mouse_x()
            my = mouse_y()
            b2 = mouse_buttons()
            if abs(mx - rest_x) > 6 or abs(my - rest_y) > 6:
                rest_x = mx
                rest_y = my
                rest_t = ticks()
                rest_done = 0
                if over == 2:
                    _over_close()
            if b2 == 1 and old_b == 0:
                held = -1
                if over == 0 and my < sh - TB and my >= 6:
                    held = _at(mx, my)
                    held_x = mx
                    held_y = my
                if held < 0:
                    if _click(mx, my) == 1:
                        break
                rest_done = 1
            elif b2 == 0 and old_b == 1 and held >= 0:
                if abs(mx - held_x) > 8 or abs(my - held_y) > 8:
                    if drawer < 0 and held < len(ITEMS):
                        _move(held, mx, my)
                elif held < len(ITEMS):
                    _open(held, 0)
                held = -1
                rest_done = 1
            elif b2 >= 2 and old_b == 0:           # the right button (or the middle one)
                _over_close()
                _right(mx, my)
                rest_done = 1
            old_b = b2
            cursor_show(mx, my)
        else:
            if cabinet_changes() != seen_cabinet:
                _collect()
                _all()
                cursor_show(mx, my)
            elif tasks_changes() != seen_tasks:
                cursor_hide()
                _taskbar()
                seen_tasks = tasks_changes()
                cursor_show(mx, my)
            elif ticks() - last >= 100:
                last = ticks()
                if over == 0:
                    cursor_hide()
                    _clock()
                    cursor_show(mx, my)
            elif rest_done == 0 and over == 0 and old_b == 0 and ticks() - rest_t >= 70:
                rest_done = 1
                n = _at(mx, my)
                if n >= 0 and my < sh - TB:
                    _card(n)
                    cursor_show(mx, my)
    log("[desk2] closed")
    return 0
