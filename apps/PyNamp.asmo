# pynamp.py - PyNamp (NinuxOS v2.9.33)
#
# The kernel's sound buffer holds about five seconds, so a song is played a
# piece at a time: sound_play(name, offset) gives the device up to four
# seconds and says how many bytes that was; when that time is over the next
# piece follows. (Between two pieces there can be a very short gap - the
# price of having no streaming sound yet.)
#
# Keys: Space = play / pause, Enter = play the chosen song, arrows = choose,
# N / P = next / previous, S = stop, ESC = close (the music stops).

META = {"type": "icon", "label": "PyNamp", "kind": "app", "icon": "icon_pynamp"}

WX = 150
WY = 80
WW = 460
WH = 430
ROWS = 10
SONGS = []
BARS = []
nsong = 0
sel = 0
top = 0
playing = -1
paused = 0
off = 0
due = 0
shown = -1
status = "Space = play / pause, Enter = this song, N / P = next / previous."


def draw(x, y):
    fill_round(x + 26, y + 6, 44, 44, 0x1A1F1A, 10)
    fill(x + 32, y + 14, 32, 14, 0x0A0F0A)
    fill(x + 35, y + 22, 3, 4, 0x39FF6A)
    fill(x + 40, y + 18, 3, 8, 0x39FF6A)
    fill(x + 45, y + 20, 3, 6, 0x39FF6A)
    fill(x + 50, y + 16, 3, 10, 0x39FF6A)
    fill(x + 55, y + 21, 3, 5, 0x39FF6A)
    fill_round(x + 32, y + 34, 9, 9, 0x8A93A6, 2)
    fill_round(x + 43, y + 34, 9, 9, 0x8A93A6, 2)
    fill_round(x + 54, y + 34, 9, 9, 0x8A93A6, 2)
    text(x + 24, y + 58, "PyNamp", 0xFFFFFF)


def _status(s):
    global status
    status = s
    fill(WX + 12, WY + 402, WW - 24, 18, 0x15181D)
    text(WX + 14, WY + 403, status, 0x9AA0B6)


def _scan():
    global nsong
    while len(SONGS) > 0:
        SONGS.pop()
    n = ob_count()
    i = 0
    while i < n:
        t = ob_meta(i, "type")
        if t == "sound":
            SONGS.append(ob_meta(i, "name"))
        i = i + 1
    nsong = len(SONGS)


def _time():
    global shown
    s = off // 192000
    if playing >= 0 and paused == 0:
        left = due - ticks()
        if left > 0:
            s = (off - left * 1920) // 192000
    if s < 0:
        s = 0
    if s == shown:
        return 0
    shown = s
    m = s // 60
    s = s % 60
    t = str(m) + ":"
    if s < 10:
        t = t + "0"
    t = t + str(s)
    fill(WX + 20, WY + 44, 96, 40, 0x0A0F0A)
    text(WX + 34, WY + 56, t, 0x39FF6A)
    return 1


def _title():
    fill(WX + 124, WY + 44, WW - 144, 18, 0x0A0F0A)
    if playing >= 0:
        text(WX + 130, WY + 45, SONGS[playing], 0x39FF6A)
        if paused == 1:
            text(WX + WW - 90, WY + 45, "paused", 0xFFB020)
    else:
        text(WX + 130, WY + 45, "- stopped -", 0x4A7A55)


def _bars():
    # the dancing bars: not a real spectrum, only a sign that it plays
    fill(WX + 124, WY + 64, WW - 144, 20, 0x0A0F0A)
    i = 0
    while i < 24:
        h = 2
        if playing >= 0 and paused == 0:
            h = BARS[i] + random(7) - 3
            if h < 2:
                h = 2
            if h > 18:
                h = 18
            BARS[i] = h
        fill(WX + 130 + i * 12, WY + 84 - h, 9, h, 0x39FF6A)
        i = i + 1


def _buttons():
    fill(WX + 12, WY + 94, WW - 24, 34, 0x15181D)
    i = 0
    while i < 5:
        bx = WX + 20 + i * 62
        c = 0x2A3038
        if i == 1 and playing >= 0 and paused == 0:
            c = 0x1F6B3A
        if i == 2 and paused == 1:
            c = 0x7A5A10
        fill_round(bx, WY + 98, 56, 26, c, 6)
        i = i + 1
    text(WX + 34, WY + 103, "Prev", 0xECECF5)
    text(WX + 96, WY + 103, "Play", 0xECECF5)
    text(WX + 154, WY + 103, "Pause", 0xECECF5)
    text(WX + 220, WY + 103, "Stop", 0xECECF5)
    text(WX + 282, WY + 103, "Next", 0xECECF5)
    fill_round(WX + WW - 100, WY + 98, 80, 26, 0x2A3038, 6)
    text(WX + WW - 88, WY + 103, "Refresh", 0xECECF5)


def _list():
    fill(WX + 12, WY + 136, WW - 24, ROWS * 24 + 12, 0x0E1014)
    if nsong == 0:
        text(WX + 22, WY + 146, "No sound objects in the cabinet.", 0x9AA0B6)
        text(WX + 22, WY + 170, "Bring a WAV from a FAT32 stick, in the shell:", 0x6B7088)
        text(WX + 22, WY + 190, "    files            (what is on the stick)", 0x6B7088)
        text(WX + 22, WY + 210, "    files get song.wav", 0x6B7088)
        text(WX + 22, WY + 234, "48 000 Hz, 16 bits, stereo, not compressed.", 0x6B7088)
        return 0
    r = 0
    while r < ROWS and top + r < nsong:
        i = top + r
        y = WY + 142 + r * 24
        if i == sel:
            fill_round(WX + 16, y - 2, WW - 32, 22, 0x1E2A22, 5)
        c = 0xC9CEDE
        if i == playing:
            c = 0x39FF6A
        text(WX + 24, y + 1, str(i + 1) + ".", 0x6B7088)
        text(WX + 60, y + 1, SONGS[i], c)
        r = r + 1
    return 1


def _frame():
    cursor_hide()
    window(WX, WY, WW, WH, "PyNamp")
    fill(WX + 12, WY + 36, WW - 24, 56, 0x15181D)
    fill(WX + 20, WY + 44, 96, 40, 0x0A0F0A)
    _title()
    _bars()
    _buttons()
    _list()
    _status(status)


def _feed():
    # the next piece of the playing song -> 1, or 0 when nothing more came
    global off, due
    n = sound_play(SONGS[playing], off)
    if n == 0:
        return 0
    off = off + n
    due = ticks() + n // 1920
    return 1


def _stop():
    global playing, paused, off, shown
    sound_stop()
    playing = -1
    paused = 0
    off = 0
    shown = -1
    _time()
    _title()
    _bars()
    _buttons()
    _list()


def _play(i):
    global playing, paused, off, shown, sel, top
    if i < 0 or i >= nsong:
        return 0
    sound_stop()
    playing = i
    sel = i
    if sel < top:
        top = sel
    if sel >= top + ROWS:
        top = sel - ROWS + 1
    paused = 0
    off = 0
    shown = -1
    if _feed() == 0:
        playing = -1
        _title()
        _buttons()
        _list()
        _status("'" + SONGS[i] + "' can't be played (no sound device, or not 48 kHz 16-bit stereo).")
        return 0
    _title()
    _time()
    _buttons()
    _list()
    _status("Playing " + str(i + 1) + " of " + str(nsong) + ".")
    return 1


def _pause():
    global paused, off, shown
    if playing < 0:
        if nsong > 0:
            _play(sel)
        return 0
    if paused == 0:
        left = due - ticks()
        if left > 0:
            off = off - left * 1920
            off = off - off % 4
            if off < 0:
                off = 0
        sound_stop()
        paused = 1
    else:
        paused = 0
        if _feed() == 0:
            _stop()
            return 0
    shown = -1
    _time()
    _title()
    _bars()
    _buttons()
    return 1


def _press(mx, my):
    global sel, top
    if my >= WY + 98 and my < WY + 124:
        if mx >= WX + WW - 100 and mx < WX + WW - 20:
            _scan()
            _list()
            _status(str(nsong) + " sound objects.")
            return 1
        i = (mx - WX - 20) // 62
        if mx < WX + 20 or i > 4 or (mx - WX - 20) % 62 >= 56:
            return 0
        if i == 0:
            if playing > 0:
                _play(playing - 1)
            elif sel > 0:
                _play(sel - 1)
        elif i == 1:
            _play(sel)
        elif i == 2:
            _pause()
        elif i == 3:
            _stop()
            _status("Stopped.")
        else:
            if playing >= 0:
                _play(playing + 1)
            else:
                _play(sel + 1)
        return 1
    if my >= WY + 140 and my < WY + 140 + ROWS * 24:
        r = top + (my - WY - 140) // 24
        if r < nsong:
            if r == sel:
                _play(r)
            else:
                sel = r
                _list()
        return 1
    return 0


def _key(k):
    global sel, top
    if k == 32:
        _pause()
    elif k == 10 or k == 13:
        _play(sel)
    elif k == 0x80:
        if sel > 0:
            sel = sel - 1
            if sel < top:
                top = sel
            _list()
    elif k == 0x81:
        if sel + 1 < nsong:
            sel = sel + 1
            if sel >= top + ROWS:
                top = sel - ROWS + 1
            _list()
    elif k == 110 or k == 78:
        if playing >= 0:
            _play(playing + 1)
        else:
            _play(sel + 1)
    elif k == 112 or k == 80:
        if playing > 0:
            _play(playing - 1)
    elif k == 115 or k == 83:
        _stop()
        _status("Stopped.")


def open(sw, sh):
    if len(BARS) == 0:
        i = 0
        while i < 24:
            BARS.append(4 + random(10))
            i = i + 1
    _scan()
    _frame()
    old_b = 0
    beat = 0
    running = 1
    while running == 1:
        e = poll()
        if e == 1:
            k = key()
            if k == 27:
                running = 0
            else:
                _key(k)
        elif e == 2:
            b = mouse_buttons()
            if b == 1 and old_b == 0:
                _press(mouse_x(), mouse_y())
            old_b = b
        if playing >= 0 and paused == 0:
            now = ticks()
            if now >= due:
                if _feed() == 0:
                    nxt = playing + 1
                    if nxt < nsong:
                        _play(nxt)
                    else:
                        _stop()
                        _status("The list is over.")
            if now - beat >= 12:
                beat = now
                _bars()
                _time()
    sound_stop()
    log("PyNamp closed")
    return 1
