        mov qword [r13+0x0],0x1
%ifdef PLAIN_KERNEL
        mov qword [rel mux_order_count],0x1
        mov qword [rel mux_order_list],0x0
        mov qword [rel mux_focused],0x0
%else
        call near mux_order             ; v3.0.16 (the same 33 bytes as the three lines it stands for)
        times 28 nop
%endif
        call mux_hooks_on
        mov byte [rel mux_on],0x1
        call fn_56e7f

