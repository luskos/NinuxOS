; rdi = the number of a task (0 .. 7) -> rax = its record (0x200 bytes at 0x43F60; +0 state: 0 free, 1 runs, 2 closing; +0x120 its name)
mux_task:
        mov rax,rdi
        shl rax,byte 0x9
        lea rax,[rax+0x43f60]
        retq

