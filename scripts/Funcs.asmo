# Functions (v1.9): def without parameters; variables are shared (global).
n = 0

def square():
    fill(200 + n * 50, 300, 40, 40, 0x6FC3FF)

def row():
    global n
    n = 0
    while n < 6:
        square()
        n += 1
        if n == 4:
            return

window(180, 260, 360, 120, "Functions")
row()
print("drew", n, "squares")
