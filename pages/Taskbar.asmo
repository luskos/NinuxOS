<html>
<head>
  <title>Taskbar</title>
  <meta name="desktop" content="no">
  <style>
    /* v1.19: the desktop's taskbar is this page. Change it in Studio
       (right-click the desktop, Show hidden objects is not needed:
       'view taskbar' in the shell, or open it from Studio with F3).
       The desktop fills in {{tasks}}, {{title}}, {{msg}}, {{hint}}, {{clock}}
       and does what the clicked part says: start, system.shell,
       system.restart, system.shutdown, task.N, or the name of an object. */
    /* v3.0.11: "Settings" opens the page curtain. */
    /* v2.8: the stencil's dock - glass pills floating on the wallpaper.
       The body is see-through: the desktop puts its wallpaper under the strip. */
    body { background: rgba(0, 0, 0, 0); margin: 0; padding: 3px 8px;
           display: flex; justify-content: space-between; align-items: center; }
    .left { display: flex; gap: 4px; align-items: center; background: rgba(28, 26, 50, 0.62);
            border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 14px; padding: 1px 6px; }
    .right { display: flex; gap: 8px; align-items: center; background: rgba(28, 26, 50, 0.62);
             border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 14px; padding: 1px 4px 1px 10px; }
    .btn { border-radius: 10px; padding: 2px 4px; }
    .btn:hover { background: rgba(255, 255, 255, 0.18); }
    .task { border-radius: 10px; background: rgba(255, 255, 255, 0.09); color: #F5F4FF; padding: 3px 10px; min-width: 104px; }
    .task:hover { background: rgba(255, 255, 255, 0.2); }
    .on { background: #7B5CFF; }
    .title { color: #C9CEDE; padding-left: 6px; }
    .msg { color: #FFB020; padding-left: 6px; padding-right: 6px; }
    .hint { color: #C9CEDE; }
    .clock { border-radius: 10px; background: rgba(123, 92, 255, 0.45); color: #FFFFFF; padding: 3px 10px; }
  </style>
</head>
<body>
  <div class="left">
    <div class="btn" onclick="start"><img src="ico_power" width="20" height="20"></div>
    <div class="btn" onclick="system.shell"><img src="ico_shell" width="20" height="20"></div>
    {{tasks}}<span class="title">{{title}}</span><span class="msg">{{msg}}</span>
  </div>
  <div class="right"><span class="hint">{{hint}}</span><div class="task" onclick="curtain">Settings</div><span class="clock">{{clock}}</span>
    <div class="btn" onclick="donate"><img src="ico_heart" width="20" height="20"></div>
    <div class="btn" onclick="system.stone"><img src="ico_stone" width="20" height="20"></div></div>
</body>
</html>
